<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Slck.Utility</RootNamespace>
    <AssemblyName>Slck.Utility</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>Slck.Utility</PackageId>
    <Version>0.0.0</Version>
    <Authors>Chandrasekhar A</Authors>
    <Description>Lightweight .NET utility library — .env file loader and guard clauses for microservices. Zero dependencies.</Description>
    <PackageTags>dotenv;utility;guard;helpers;microservices</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/chandru415/Slck.Utility</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
